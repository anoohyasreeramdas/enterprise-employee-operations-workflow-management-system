        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    if (current.start_date && current.end_date) {

        if (current.end_date < current.start_date) {
            gs.addErrorMessage('End date cannot be before start date.');
            current.setAbortAction(true);
            return;
        }

        var start = new GlideDateTime(current.start_date);
        var end = new GlideDateTime(current.end_date);

        var diff = GlideDateTime.subtract(start, end);

        current.total_days = Math.abs(diff.getDayPart()) + 1;
    }

})(current, previous);]]></script>
